# Copy to .env and fill in. Never commit the real .env.
PORT=3000
MONGO_USER=your-atlas-user
MONGO_PASSWORD=your-atlas-password
# Optional: full connection string, overrides MONGO_USER/MONGO_PASSWORD (e.g. mongodb://localhost:27017/connect_4)
# MONGO_URI=
# Long random string used to sign login tokens.
TOKEN_SECRET=change-me-to-a-long-random-string
# Frontend URL(s) allowed by CORS, comma-separated.
FRONT_URL=http://localhost:5173
